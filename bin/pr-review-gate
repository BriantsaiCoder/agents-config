#!/usr/bin/env bash
set -uo pipefail

pr=${1:-}
if [[ ! "$pr" =~ ^[0-9]+$ ]]; then
  printf 'usage: %s <pr-number>\n' "${0##*/}" >&2
  exit 64
fi

# repo= 必須出現在 UNAVAILABLE 行。這支工具用 `gh repo view` 從 **cwd** 解析 repo，所以從別的
# repo 目錄跑 `pr-review-gate 18`，查的是「那個 repo 的 #18」。其餘每個 STATE 行都帶 url=，
# 裡面就含 repo，看得出查錯了；只有 UNAVAILABLE 兩者皆無，於是「查錯 repo」與「這個 PR 真的
# 有問題」印出完全相同的一行。
#
# 實測（2026-08-01）：同一句 `pr-review-gate 18`，在 ~/.agents 回 STATE=WAIT_REVIEW ci=PASS，
# 在另一個專案目錄回 STATE=UNAVAILABLE reason=pr_not_open。當時被誤判為「暫時性讀取失敗」，
# 兩次都是。若那個 repo 剛好也有一個 open 的 #18，回報的會是它的狀態——不是錯誤，是靜默的
# 錯答案。
unavailable() {
  printf 'STATE=UNAVAILABLE repo=%s reason=%s\n' "${repo:-unresolved}" "$1"
  exit 30
}

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner) ||
  unavailable repo_probe_failed
owner=${repo%%/*}
name=${repo#*/}

pr_state=$(gh pr view "$pr" --repo "$repo" \
  --json state,isDraft,mergeable,headRefOid,statusCheckRollup,url \
  --jq '.statusCheckRollup as $checks |
    [.state, (.isDraft | tostring), .mergeable, .headRefOid,
     (if ($checks | length) == 0 then "NONE"
      else [$checks[] | (.conclusion // .state // "PENDING")] | join(",") end),
     ([$checks[]
       | (.conclusion // .state // "PENDING") as $result
       | select(["FAILURE","ERROR","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE","STALE"] | index($result))
       | if (.__typename != "CheckRun" or ((.workflowName // "") | length) == 0) then "UNTRUSTED"
         elif ((.detailsUrl // "") | length) == 0 then "MISSING"
         else .detailsUrl end]
      | if length == 0 then "NONE" else join(",") end),
     .url] | @tsv') || unavailable pr_probe_failed
# 用 cut 而非 here-string，理由同下面 latest_review_state 那處——bash 3.2 的 <<< 要建暫存
# 檔，/tmp 與 cwd 皆不可寫時建不出來（sandbox 內 cwd=~/.claude 即命中），read 不執行、
# 變數維持 unset，set -u 讓整支中止在「state: unbound variable」而非可讀的錯誤。
# cut 另有一個 here-string 沒有的好處：@tsv 會產生空欄位，而 tab 屬 IFS whitespace，
# IFS 詞彙切分會把連續 tab 併成一個、讓後面所有欄位錯位。
state=$(printf '%s' "$pr_state" | cut -f1)
draft=$(printf '%s' "$pr_state" | cut -f2)
mergeable=$(printf '%s' "$pr_state" | cut -f3)
head=$(printf '%s' "$pr_state" | cut -f4)
ci_states=$(printf '%s' "$pr_state" | cut -f5)
failed_urls=$(printf '%s' "$pr_state" | cut -f6)
url=$(printf '%s' "$pr_state" | cut -f7)

# gh 回了但欄位切不出來（jq 改格式、gh 改輸出）時，要報得出是哪裡壞，不能讓下游
# 用空字串繼續判斷後印出一個看似正常的 STATE 行。
# 驗哪些欄位，判準是「空了會不會讓某個決策靜默跳過或某行 STATE 失去意義」：
#   state      決定 pr_not_open
#   head       hard_deny[1] 整條規則綁在 "at the current head SHA"，空 head 讓綁定失效
#   mergeable  把關兩個決策 —— `mergeable == CONFLICTING → FAIL_MERGE` 那條，以及
#              `ci == WAIT || mergeable == UNKNOWN → WAIT_CI` 那條。空字串兩條都不命中，
#              直落 STATE=PASS，於是**合併衝突檢查根本沒跑**而輸出行外觀完全正常。
#              這是本檔最需要驗的一欄。（引符號不引行號：本分支已經把行號引用打歪
#              過兩次，行號會隨每次改動漂移。）
#   url        只影響輸出可讀性，但 UNAVAILABLE 以外每行都靠它看得出查的是哪個 PR
#   draft      決定 WAIT_READY。這一欄必須驗**正值**而非非空：`.isDraft | tostring`
#              讓 null 變字面 "null"（非空），emptiness 檢查永遠放行，而 "null" 不等於
#              true 於是 draft PR 被當成非 draft 一路走到 STATE=PASS —— 那是 fail-open，
#              hard_deny[1] 只認 PASS／PASS_NO_CI。S5 實測 draft=null → rc=0 STATE=PASS。
#
# 最後一條數 tab 而不是逐欄比對，一次涵蓋三種 arity drift：
#   * 整行無分隔符（cut 的 `-fN` 每個 N 都回整行，七欄全部非空、逐欄檢查全數通過）。
#     S5 實測該形狀走到 STATE=WAIT_CI 並對 GitHub 送出一次 requested_reviewers POST
#     —— 垃圾輸入不該產生外部寫入。
#   * 欄位插入（八欄以上）。S5 實測部分插入位置會走到 STATE=PASS，污染 url 欄。
#   * 欄位刪除（六欄以下）——這種多半也會被上面的 -n 接住，但不必依賴那個巧合。
# 數 tab 而非 `awk -F'\t' NF==7`：@tsv 會把值內的 tab 逸出成字面 \t，所以真正的
# tab 只可能是分隔符，數量恆為 6；而 tr 不需要多一個 awk 依賴。
[[ -n "$state" && -n "$head" && -n "$mergeable" && -n "$url" \
   && ( "$draft" == true || "$draft" == false ) \
   && "$(printf '%s' "$pr_state" | tr -cd '\t' | wc -c)" -eq 6 ]] ||
  unavailable pr_fields_unparsable

[[ "$state" == OPEN ]] || unavailable pr_not_open
if [[ "$draft" == true ]]; then
  printf 'STATE=WAIT_READY pr=%s head=%s url=%s\n' "$pr" "$head" "$url"
  exit 11
fi
if [[ "$mergeable" == CONFLICTING ]]; then
  printf 'STATE=FAIL_MERGE pr=%s head=%s url=%s\n' "$pr" "$head" "$url"
  exit 30
fi

# 零個 check 有兩種完全不同的成因，舊版一律當 WAIT，於是第二種永遠沒有出口：
#   1. run 還在排程——正常，等就好。
#   2. run 根本沒被建立——GitHub 側停擺，等到天荒地老也不會有 check。
# 2026-08-06 實測撞上第二種：head 連續三次（push、close/reopen、空 commit）都沒有建立
# 任何 CI run，同時間 Copilot review 照常排隊，gate 卡在 WAIT_CI 沒有出口，最後只能由
# 人手動 merge。用「head commit 推上來多久了」區分這兩種：本 repo 的 CI 全程 21-31 秒
# 跑完，建立 run 是秒級，10 分鐘是給排程延遲的寬裕上限。
CI_ABSENT_AFTER=${CI_ABSENT_AFTER:-600}
# 這個值來自環境，且唯一的用途是進 past_threshold() 的 (( )) 算術脈絡。非數字值在那裡
# 會被當成變數名，set -u 讓整支中止——而 bash 3.2 由算術脈絡觸發的中止 **exit status
# 是 0**、stdout 全空，正是下面 thread 那組 guard 已經寫明「這支工具最不能有的形狀」。
# 三處數值 guard 裡只有這一條是使用者自己就能觸發的（export 一個打錯的值）。
[[ "$CI_ABSENT_AFTER" =~ ^[0-9]+$ ]] || unavailable ci_absent_after_invalid

# ISO8601 轉 epoch。BSD date（macOS）與 GNU date（Linux/CI）語法不同，兩種都試。
epoch_of() {
  date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null ||
    date -u -d "$1" +%s 2>/dev/null
}

# head commit 是否已經舊到「該來的 run 早就該來了」。取不到時間、date 兩種語法都解析
# 失敗、時鐘偏移讓年齡變成負數，全部回 false——判不出年齡就不准降級，方向一律保守。
past_threshold() {
  local d e
  d=$(gh api "repos/$repo/commits/$head" --jq '.commit.committer.date' 2>/dev/null) || return 1
  [[ -n "$d" ]] || return 1
  e=$(epoch_of "$d") || return 1
  [[ -n "$e" ]] || return 1
  (( $(date -u +%s) - e >= CI_ABSENT_AFTER ))
}

# 被取消的 job 到底有沒有真的跑過。GitHub 不提供「誰取消了這個 run」——run 與 job 物件
# 的欄位清單裡都沒有 cancelled_by，只有觸發者；個人帳號也沒有 audit log API。但 steps
# 陣列給得出更有用的區分：
#
#   steps 為空   runner 拿到 job 卻一個 step 都沒開始，CI 等於從未執行，語意上與
#                「零個 check」相同。2026-08-06 Actions 事故實測：job 掛了 15 分 3 秒、
#                steps=0，公告寫的是 runners being assigned jobs that are no longer valid。
#   steps 有內容 曾實際執行過。取消可能正好中斷了一個即將失敗的測試，那不是「拿不到
#                結論」而是「結論被中斷」，必須照舊當 FAIL 擋死。
#
# 對照組（同一支 workflow 正常跑完）是 steps=7、每個 step 都有 conclusion，所以這個
# 訊號分得開。查不到 jobs（第三方 check、API 失敗、根本找不到 cancelled run）一律回
# false，不降級。
cancelled_jobs_never_ran() {
  local ids id steps
  ids=$(gh api "repos/$repo/actions/runs?head_sha=$head" \
    --jq '.workflow_runs[] | select(.conclusion == "cancelled") | .id' 2>/dev/null) || return 1
  [[ -n "$ids" ]] || return 1
  for id in $ids; do
    steps=$(gh api "repos/$repo/actions/runs/$id/jobs" \
      --jq '[.jobs[].steps | length] | add // 0' 2>/dev/null) || return 1
    [[ "$steps" == 0 ]] || return 1
  done
  return 0
}

# Actions quota／billing failure 的 job 不會執行任何 step；只有 rollup 裡每個 hard failure
# 都直接指向符合該形狀、且 annotation 命中 GitHub 固定訊息的 Actions job 時才降級。
# 第三方 check、任一 API／annotation／step 不符都回 false，繼續當真正 CI failure 擋住。
billing_failure_never_ran() {
  local url path run_id job_id job conclusion steps job_head job_run_id
  local -a urls
  [[ -n "$failed_urls" && "$failed_urls" != NONE ]] || return 1
  case "$failed_urls" in ,*|*,|*,,*) return 1 ;; esac
  IFS=',' read -r -a urls < <(printf '%s\n' "$failed_urls")
  for url in "${urls[@]}"; do
    case "$url" in
      "https://github.com/$repo/actions/runs/"*"/job/"*) ;;
      *) return 1 ;;
    esac
    path=${url#"https://github.com/$repo/actions/runs/"}
    run_id=${path%%/job/*}
    job_id=${path##*/job/}; job_id=${job_id%%\?*}
    [[ "$run_id" =~ ^[0-9]+$ && "$job_id" =~ ^[0-9]+$ ]] || return 1
    job=$(gh api "repos/$repo/actions/jobs/$job_id" \
      --jq 'if ((.conclusion | type) == "string" and (.steps | type) == "array" and
                (.head_sha | type) == "string" and (.run_id | type) == "number")
            then [.conclusion, (.steps | length), .head_sha, (.run_id | tostring)] | @tsv
            else error("invalid job shape") end' 2>/dev/null) || return 1
    conclusion=$(printf '%s' "$job" | cut -f1)
    steps=$(printf '%s' "$job" | cut -f2)
    job_head=$(printf '%s' "$job" | cut -f3)
    job_run_id=$(printf '%s' "$job" | cut -f4)
    [[ "$conclusion" == failure && "$steps" == 0 &&
       "$job_head" == "$head" && "$job_run_id" == "$run_id" ]] || return 1
    gh api "repos/$repo/check-runs/$job_id/annotations" --jq '
      any(.[];
        ((.message // "") | ascii_downcase | contains("job was not started")) and
        ((.message // "") | ascii_downcase | contains("payments have failed or your spending limit needs to be increased")))' \
      2>/dev/null | grep -qx true || return 1
  done
}

ci=PASS
if [[ "$ci_states" == NONE ]]; then
  # 預設仍是 WAIT，只有確定超過門檻才改判 ABSENT。
  ci=WAIT
  past_threshold && ci=ABSENT
else
  # 三種結果分開統計，不能邊掃邊覆寫 ci——CANCELLED 要不要降級得等全部掃完才知道，
  # 而硬失敗與「還在跑」的優先序必須壓過它。
  hard_fail=0
  in_progress=0
  cancelled=0
  # process substitution 而非 here-string（理由同 pr_state 那處），也不用 `| while`——
  # 後者會把迴圈丟進 subshell，hard_fail／in_progress／cancelled 三個計數全部丟失。
  # process substitution 沒有這個問題，迴圈留在當前 shell，所以不需要先收進陣列再跑
  # 第二輪；case 直接寫在 while body 裡，順帶避開 set -u 對空陣列展開的那個坑。
  # printf 的結尾換行不可省：沒有它，最後一行（單一 check 時就是唯一一行）會讓 read
  # 回非零而不進迴圈體，整個迴圈一次都不跑。
  # 不走 IFS 詞彙切分的理由不是「內部空欄位」——逗號是 non-whitespace IFS，`A,,B` 本來
  # 就切成三欄。真正的差別是尾端空欄位（`SUCCESS,` 只切出一欄，下面的 "" case 就不會
  # 命中）與空輸入（set -u 下展開空陣列直接中止）。tr + read 兩者都保留。
  while IFS= read -r check; do
    case "$check" in
      SUCCESS|NEUTRAL|SKIPPED) ;;
      CANCELLED) cancelled=1 ;;
      PENDING|IN_PROGRESS|QUEUED|EXPECTED|WAITING|REQUESTED|"") in_progress=1 ;;
      FAILURE|ERROR|TIMED_OUT|ACTION_REQUIRED|STARTUP_FAILURE|STALE) hard_fail=1 ;;
      # 沒見過的狀態當「還在跑」，不當通過也不當取消。
      *) in_progress=1 ;;
    esac
  done < <(printf '%s\n' "$ci_states" | tr ',' '\n')
  if [[ "$hard_fail" -eq 1 ]]; then
    if [[ "$in_progress" -eq 0 && "$cancelled" -eq 0 ]] && billing_failure_never_ran; then
      ci=BILLING_QUOTA
    else
      ci=FAIL
    fi
  elif [[ "$in_progress" -eq 1 ]]; then
    # 還有 check 在跑就繼續等，即使同時有 CANCELLED——重跑後的新 run 正是這個形狀。
    ci=WAIT
  elif [[ "$cancelled" -eq 1 ]]; then
    # 取消且沒有別的 check 在跑。先看 job 有沒有真的執行過，再看等夠久了沒——順序
    # 反過來的話，「跑到一半被取消」這種確定要擋的情況還要空等十分鐘才判得出來。
    # cancelled_jobs_never_ran 在查不到資料時回 false，於是落到 FAIL，方向保守。
    if ! cancelled_jobs_never_ran; then
      ci=FAIL
    elif past_threshold; then
      ci=CANCELLED
    else
      # 從未執行過，但還沒等夠——這段時間內可能有人重跑，重跑後會變成 in_progress。
      ci=WAIT
    fi
  fi
fi

# 同一次呼叫一併取出 latest review 的 commit_id 與 **suppressed comments 數**。
#
# 為什麼要取後者：Copilot 會把部分 finding 收進 review body 的 "Suppressed comments"
# 摺疊區，那些**不會**產生 review thread，因此不計入下面的 unresolved。2026-08-08
# 一輪跨四 repo 的守衛修正中，六條 finding 有四條在該區塊，而 gate 在同一輪回過三次
# STATE=PASS——每次都有未修的 fail-open。只看 unresolved 會漏掉整類。
#
# 不阻擋、只呈報：suppressed 沒有 resolve 機制，拿它當 blocking 條件會變成永久死鎖。
# 呈報在這行輸出上，是因為它是 push 後 hook 會自動印、且所有人都會讀的那一行。
# scan 而非 capture：後者在無命中時會 raise error，前者回空陣列。
latest_review_state=$(gh api "repos/$repo/pulls/$pr/reviews" \
  --jq '[.[] | select(.user.login | ascii_downcase | contains("copilot"))]
    | sort_by(.submitted_at) | last
    | [ (.commit_id // ""),
        ((.body // "") | [scan("Suppressed comments \\(([0-9]+)\\)")]
          | if length > 0 then .[0][0] else "0" end)
        , ((.body // "") | ascii_downcase
          | (. == "the job was not started because recent github actions payments have failed or your spending limit needs to be increased." or
             . == "the job was not started because recent account payments have failed or your spending limit needs to be increased."))
      ] | @tsv') ||
  unavailable review_probe_failed
# 用 cut 而非 here-string：後者在 /tmp 與 cwd 皆不可寫時建不出暫存檔（macOS bash 3.2），
# read 不執行、變數維持 unset，set -u 會讓整支中止。那是 fail-closed 沒錯，但沒必要
# 為了拆兩個欄位引入一個會炸的相依。
latest_review=$(printf '%s' "$latest_review_state" | cut -f1)
suppressed=$(printf '%s' "$latest_review_state" | cut -f2)
billing_review=$(printf '%s' "$latest_review_state" | cut -f3)
# 三處 tsv 解析裡這處原本是唯一沒有 *_fields_unparsable guard 的，形狀比照上面 pr_state：
#   數 tab 一次涵蓋三種 arity drift。最重要的是「整行無分隔符」——cut -fN 每個 N 都回
#   整行，於是 latest_review 拿到整行，只要它不等於 head 就走 review=STALE，而該分支會
#   對 GitHub 送出一次 requested_reviewers POST。垃圾輸入產生外部寫入，與 pr_state 那條
#   同型（實測：STATE=REQUESTED、requests=1）。
#   billing_review 驗正值而非非空，理由同 draft：它是布林語意的欄位，任何非 true/false
#   的值都靜默讀成「不是 billing」，於是 review=UNAVAILABLE 這條出口整個消失。
#   suppressed 從「靜默改判為 0」升級為擋下來：jq 那段在無命中時已經自己回字面 "0"，
#   所以走到這裡還不是數字就只可能是 shape drift。靜默歸零會讓 2026-08-08 那類
#   「finding 全在 Suppressed 摺疊區而 gate 回 PASS」的 fail-open 無聲復發（實測：
#   多一欄／billing 非布林／suppressed 非數字三種形狀都直落 STATE=PASS suppressed=0）。
# latest_review 刻意不驗非空：`.commit_id // ""` 在「這個 PR 還沒有任何 Copilot review」
# 時就是空字串，那是合法輸入，驗非空會把最常見的新 PR 誤擋成欄位壞掉。
[[ ( "$billing_review" == true || "$billing_review" == false ) \
   && "$suppressed" =~ ^[0-9]+$ \
   && "$(printf '%s' "$latest_review_state" | tr -cd '\t' | wc -c)" -eq 2 ]] ||
  unavailable review_fields_unparsable
requested=$(gh api "repos/$repo/pulls/$pr/requested_reviewers" \
  --jq '[.users[] | select(.login | ascii_downcase | contains("copilot"))] | length') ||
  unavailable requested_reviewer_probe_failed
# jq 的 length 恆為數字，所以這條的可達性低——留著是因為它守的是同一個「rc=0、stdout
# 全空」形狀，而 requested 有兩個算術脈絡消費端（review=STALE 分支與末尾的 WAIT_REVIEW
# 判定）。一行的成本，不必為可達性辯論。
[[ "$requested" =~ ^[0-9]+$ ]] || unavailable requested_fields_unparsable
thread_state=$(gh api graphql -F owner="$owner" -F name="$name" -F number="$pr" -f query='
  query($owner: String!, $name: String!, $number: Int!) {
    repository(owner: $owner, name: $name) {
      pullRequest(number: $number) {
        reviewThreads(first: 100) {
          nodes {
            isResolved
            comments(first: 1) { nodes { author { login } } }
          }
          pageInfo { hasNextPage }
        }
      }
    }
  }' --jq '[
    ([.data.repository.pullRequest.reviewThreads.nodes[]
      | select(.isResolved == false)
      | select(any(.comments.nodes[]?;
          (.author.login // "" | ascii_downcase | contains("copilot"))))]
      | length),
    .data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage
  ] | @tsv') || unavailable thread_probe_failed
unresolved=$(printf '%s' "$thread_state" | cut -f1)   # cut 而非 here-string，理由同 pr_state 那處
has_next=$(printf '%s' "$thread_state" | cut -f2)
# 數值 guard 必須在 has_next 判斷之前，而且不能省。cut -fN 對「整行無分隔符」的輸入
# **每個 N 都回整行**，所以 thread_state="false" 會讓 unresolved 與 has_next 同時變成
# "false"：has_next 檢查放行，接著 [[ "$unresolved" -gt 0 ]] 在算術脈絡把 false 當變數名，
# set -u 中止——而 bash 3.2 由 [[ ]] 算術脈絡觸發的中止 **exit status 是 0**、stdout 全空。
# 那是這支工具最不能有的形狀：呼叫端比對 STATE= 字串會拿到空字串，只看 exit code 的會
# 當成通過。比照 suppressed 的既有數值 guard。
[[ "$unresolved" =~ ^[0-9]+$ ]] || unavailable thread_fields_unparsable
# has_next 與 draft 同型：驗正值而非非空。上面那條數值 guard 擋不住「tsv 是純數字」
# （例如 "5"）與「第二欄為空」兩個形狀 —— 兩者 unresolved 都通過數值檢查，而 has_next
# 拿到 "5" 或 ""，於是報 review_thread_limit_exceeded 這個假原因。方向本來就 fail-closed，
# 這條補的是「報得出真因」。
[[ "$has_next" == true || "$has_next" == false ]] || unavailable thread_fields_unparsable
# 走到這裡只剩字面 true 或 false；true 代表還有下一頁沒讀，fail-closed。
[[ "$has_next" == false ]] || unavailable review_thread_limit_exceeded

review=CURRENT
requested_now=false
if [[ "$billing_review" == true ]]; then
  review=UNAVAILABLE
elif [[ "$latest_review" != "$head" ]]; then
  review=STALE
  if [[ "$requested" -eq 0 ]]; then
    gh api --method POST "repos/$repo/pulls/$pr/requested_reviewers" \
      -f 'reviewers[]=copilot-pull-request-reviewer[bot]' >/dev/null ||
      unavailable review_request_failed
    requested_now=true
  fi
fi

if [[ "$unresolved" -gt 0 ]]; then
  printf 'STATE=FINDINGS pr=%s head=%s ci=%s review=%s unresolved=%s url=%s\n' \
    "$pr" "$head" "$ci" "$review" "$unresolved" "$url"
  exit 20
fi
if [[ "$ci" == FAIL ]]; then
  printf 'STATE=FAIL_CI pr=%s head=%s review=%s unresolved=0 url=%s\n' \
    "$pr" "$head" "$review" "$url"
  exit 30
fi
if [[ "$ci" == WAIT || "$mergeable" == UNKNOWN ]]; then
  printf 'STATE=WAIT_CI pr=%s head=%s ci=%s review=%s unresolved=0 url=%s\n' \
    "$pr" "$head" "$ci" "$review" "$url"
  exit 10
fi
if [[ "$review" == UNAVAILABLE ]]; then
  if [[ "$ci" == BILLING_QUOTA ]]; then
    printf 'STATE=PASS_NO_CI pr=%s head=%s ci=%s review=UNAVAILABLE reason=actions_billing_or_quota unresolved=0 suppressed=%s url=%s\n' \
      "$pr" "$head" "$ci" "$suppressed" "$url"
    exit 12
  fi
  printf 'STATE=UNAVAILABLE repo=%s pr=%s head=%s ci=%s review=UNAVAILABLE reason=review_actions_billing_or_quota unresolved=0 url=%s\n' \
    "$repo" "$pr" "$head" "$ci" "$url"
  exit 30
fi
if [[ "$requested_now" == true ]]; then
  printf 'STATE=REQUESTED pr=%s head=%s ci=%s review=STALE unresolved=0 url=%s\n' \
    "$pr" "$head" "$ci" "$url"
  exit 11
fi
if [[ "$latest_review" != "$head" || "$requested" -gt 0 ]]; then
  printf 'STATE=WAIT_REVIEW pr=%s head=%s ci=%s review=STALE unresolved=0 url=%s\n' \
    "$pr" "$head" "$ci" "$url"
  exit 11
fi

# review 面全綠但 CI run 根本沒被建立時，回一個**與 PASS 不同**的狀態。這裡刻意不回
# PASS：呼叫端若只看到 PASS，就分不出「CI 驗過了」與「CI 從來沒跑」，而後者要不要放行
# 是策略決定，屬於上層（hook／settings／人），不是這支工具能替它們決定的。
# exit 12 同樣刻意非 0——只看 exit code 的呼叫端會當成不通過，那是正確的預設方向；
# 要接受降級的呼叫端必須明確認得 PASS_NO_CI 這個字串。
# ci= 保留實際來源，不統一成一個字：ABSENT 是 run 根本沒被建立，CANCELLED 是 run 建立了
# 但 job 一個 step 都沒跑就被取消。兩者都代表「拿不到 CI 結論」，但排查方向完全不同。
if [[ "$ci" == ABSENT || "$ci" == CANCELLED || "$ci" == BILLING_QUOTA ]]; then
  printf 'STATE=PASS_NO_CI pr=%s head=%s ci=%s review=CURRENT unresolved=0 suppressed=%s url=%s\n' \
    "$pr" "$head" "$ci" "$suppressed" "$url"
  exit 12
fi

printf 'STATE=PASS pr=%s head=%s ci=%s review=CURRENT unresolved=0 suppressed=%s url=%s\n' \
  "$pr" "$head" "$ci" "$suppressed" "$url"
