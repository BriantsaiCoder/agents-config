#!/usr/bin/env bash
#
# hook-parity-check — 警告 [T0-3] guard 的 host 副本已與正本漂移。
#
# 為什麼需要這支：guard-git-push.sh 自 `72ed5a7`（2026-07-29 三家設定分離）起不再是
# 指向 ~/.agents 的 wrapper，而是三份實體副本，沒有部署機制會同步它們。
#
# 三個關鍵事實各附探針（CONVENTIONS 規則 5）：
#   1. 三份是實體檔不是 symlink：
#      ls -l ~/.agents/hooks/guard-git-push.sh ~/.claude/hooks/guard-git-push.sh \
#            ~/.codex/hooks/guard-git-push.sh    # 期望三行皆 -rwx，無 lrwx
#   2. 各 host 執行自己那份，不是 ~/.agents 那份：
#      jq -r '.hooks.PreToolUse[].hooks[].command' ~/.codex/hooks.json   # → $HOME/.codex/hooks/…
#      grep -n 'dirname' ~/.codex/hooks/guard-codex-git-push.sh          # → exec $(dirname $0)/…
#      推論：~/.agents/hooks/ 底下的檔沒有任何 host 會執行。
#   3. CI 比不了：~/.claude/tests/repo-integrity.sh:43-45 記載 CI 環境沒有 ~/.agents。
#
# 為什麼放 bin/ 而不是 hooks/：由事實 2，把邏輯放 ~/.agents/hooks/ 等於沒生效。bin/ 是
# 三家實際會呼叫的唯一共用目錄（bin/agents-branch、bin/pr-review-gate 皆由三家 config
# 引用）。探針：grep -rn 'bin/agents-branch\|bin/pr-review-gate' ~/.claude/core \
#   ~/.codex/AGENTS.md ~/.copilot/copilot-instructions.md
#
# Copilot 刻意排除：~/.copilot/hooks/guard-git-push.sh 是獨立實作（payload 契約不同——
# toolName／toolArgs 對 tool_input），比 hash 會永遠回報漂移。探針：
#   grep -c 'toolName' ~/.copilot/hooks/guard-git-push.sh   # → 非 0
#
# 用法：hook-parity-check          印警告到 stderr，一律 exit 0（非阻擋，供 SessionStart）
#       hook-parity-check --strict 有漂移則 exit 1（供 tests/hook-parity.sh）
#
# 缺檔語意：host 目錄不存在＝該 host 未安裝，合法跳過；host 目錄存在但 guard 不見了＝
# 該 host 的 [T0-3] 防線消失，這是最嚴重的漂移，必須報。正本不存在同樣必須報——
# 靜默通過會讓「防線整批消失」看起來跟「三份一致」一樣。
set -uo pipefail

AGENTS="${AGENTS_HOME:-$HOME/.agents}"
CANONICAL="$AGENTS/hooks/guard-git-push.sh"

strict=0
[ "${1:-}" = '--strict' ] && strict=1

# 可用 PARITY_COPIES 覆寫（tests/hook-parity.sh 用 fixture 路徑注入）。
COPIES="${PARITY_COPIES:-$HOME/.claude/hooks/guard-git-push.sh $HOME/.codex/hooks/guard-git-push.sh}"

sha_of() { shasum -a 256 "$1" 2>/dev/null | awk '{ print $1 }'; }
warn() { printf '%s\n' "$@" >&2; }

drift=0

if [ ! -f "$CANONICAL" ]; then
  warn "[T0-3] guard 正本不存在：$CANONICAL" \
       '  無法比對任何副本；若 ~/.agents 尚未 clone 或 checkout 到別的 branch 屬預期，否則防線正本已遺失。'
  [ "$strict" = 1 ] && exit 1
  exit 0
fi

want="$(sha_of "$CANONICAL")"
if [ -z "$want" ]; then
  warn "[T0-3] guard 正本無法計算 hash：$CANONICAL（shasum 不可用？）"
  [ "$strict" = 1 ] && exit 1
  exit 0
fi

for copy in $COPIES; do
  if [ ! -f "$copy" ]; then
    # host 目錄不存在＝未安裝該 host，跳過；存在卻沒 guard＝防線消失，要報。
    [ -d "$(dirname "$copy")" ] || continue
    drift=1
    warn "[T0-3] guard 副本缺失：$copy" \
         "  該 host 的 hooks 目錄存在但 guard 不見了——force-push 前置攔截對它已無效。" \
         "  正本在 $CANONICAL，複製過去即可恢復。"
    continue
  fi

  got="$(sha_of "$copy")"
  [ "$got" = "$want" ] && continue
  drift=1
  warn "[T0-3] guard 副本已漂移：$copy" \
       "  期望 ${want:0:12}…（正本 $CANONICAL）" \
       "  實際 ${got:0:12}…" \
       '  判定邏輯要同步三處；只改一處會讓該 host 的 force-push 防線與其他兩家不同。'
done

[ "$strict" = 1 ] && exit "$drift"
exit 0
