#!/usr/bin/env bash
#
# agents-sync — 三主機共用設定生成器（正本在 ~/.agents/core|hosts|rules）
#
# 用法:
#   agents-sync            生成 + 部署三家（no-clobber 守護；不覆寫無 banner 的手寫檔）
#   agents-sync --only <s> 僅部署 host_key 含子字串 s 的 target（如 copilot / codex）；lint/manifest 仍全量
#   agents-sync --check    dry-run：跑 lint + 印將寫入的位元組數 / diff，不寫任何檔
#   agents-sync --bootstrap 重建 ~/.claude 下相對 symlink（skills/rules）+ 部署三家
#   agents-sync --doctor   巡檢：斷鏈 0、manifest 相符、override 不存在、印三家 FP 探針指令
#
# 設計權威：proposals/2026-07-07-three-host-unification/02-config-layer.md
# 部署根可用 AGENTS_DEPLOY_ROOT 覆寫（預設 $HOME）——供 dry-run 部署到 scratch 驗冪等，不動 live host。
set -euo pipefail

AGENTS="${AGENTS_HOME:-$HOME/.agents}"
DEPLOY_ROOT="${AGENTS_DEPLOY_ROOT:-$HOME}"
ONLY=''           # --only <host 子字串>：deploy 僅寫 host_key 含此子字串的 target（空=全部；lint/manifest 不受限）
cd "$AGENTS"

# ── targets 資料表（新增第 4 家 CLI 只加一列，不改腳本邏輯；02 line 59）──
#   host_key | output(相對 $DEPLOY_ROOT) | delta 檔
TARGETS='
codex|.codex/AGENTS.md|hosts/codex-delta.md
copilot|.copilot/copilot-instructions.md|hosts/copilot-delta.md
'

BUDGET=10240      # 每 host 常駐注入位元組上限（05 rule 8 / 02 lint 5）
TIER0_MAX=30      # tier0 行數上限
ROUTING_MAX=30    # routing 區塊行數上限

die()  { printf 'agents-sync: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }

# 可攜 sha256（macOS shasum / Linux sha256sum）
sha256_hex() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
  else shasum -a 256 | cut -d' ' -f1; fi
}
git_sha() { git rev-parse --short HEAD 2>/dev/null || echo nogit; }

# 去掉每個組件的 bookkeeping metadata 首行（<!-- tier: ... -->）；FP 行與本體保留供探針
strip_meta() { sed '/^<!-- tier:/d' "$1"; }

# 機械生成 skill-index（05 rule 7：手寫清單禁止，索引只准機械生成）
# 產物落 dist/skill-index.md 供 lint 名稱校驗 + Claude 參考；不注入 host 常駐預算——
# 三家皆原生枚舉自身 skill 名，注入全量 52 名是重複的注意力稅（02 line 81 attention-economy）。
emit_skill_index() {
  local n; n="$(ls -1 skills | wc -l | tr -d ' ')"
  printf '<!-- agents-skill-index:begin (機械生成 · %s 個 · 勿手改) -->\n' "$n"
  ls -1 skills
  printf '<!-- agents-skill-index:end -->\n'
}

# 組裝一個 host 的本體（不含 banner）。$1 = delta 檔路徑
# 順序依 02 line 56：tier0/1/2 + [PIN 表] + routing + delta（skill-index 改 dist-only，見上）
assemble_body() {
  local delta="$1"
  strip_meta core/tier0-safety.md;   echo
  strip_meta core/tier1-workflow.md; echo
  strip_meta core/tier2-style.md;    echo
  # PIN 表：rules/*.md 的 <!-- PIN --> 區塊（rules/ 尚未遷入時為空，Step 5 後生效）
  # FNR==1{f=0}：每檔開頭重置旗標——某檔漏閉合 <!-- /PIN --> 不會讓 f 殘留、把下一檔內容洩進 PIN 表（會毒害三家）
  # 非空才輸出：無 PIN 區塊時不追加空行，維持 body 與遷入前逐字元一致（避免無謂 redeploy）
  if compgen -G 'rules/*.md' >/dev/null 2>&1; then
    local pin
    pin="$(awk 'FNR==1{f=0} /<!-- PIN -->/{f=1;next} /<!-- \/PIN -->/{f=0} f' rules/*.md)"
    [ -n "$pin" ] && { printf '%s\n' "$pin"; echo; }
  fi
  strip_meta core/routing.md;        echo
  strip_meta "$delta"
}

# 完整部署內容 = banner(含 git-sha + 本體 hash 前8碼) + 本體。$1 = delta 檔
render_target() {
  local body gsha hsh
  body="$(assemble_body "$1")"
  gsha="$(git_sha)"
  hsh="$(printf '%s' "$body" | sha256_hex | cut -c1-8)"
  printf '<!-- GENERATED by ~/.agents/bin/agents-sync @%s hash:%s — 勿手改；改 ~/.agents/core|hosts|rules -->\n' "$gsha" "$hsh"
  printf '%s\n' "$body"
}

# 目標檔自洽驗證：banner 內記錄的 body hash（前8碼）== 現檔 body 實算 hash。
#   相符 → 未經手改的生成檔（可能已過期於 source 變更），可安全覆寫。
#   不符 → banner 在但 body 遭手改/竄改（或手寫檔冒用 banner 前綴），拒覆寫 fail-loud。
# 用 banner 內嵌 hash 而非 manifest：source 變更後過期的乾淨檔仍自洽，免除 stale-vs-tamper 誤判
# （manifest 反映當前 source，會把「乾淨但過期」誤判成「被竄改」而錯拒正常再生）。
banner_body_hash_matches() {
  local target="$1" want got
  want="$(head -1 "$target" | sed -n 's/.*hash:\([0-9a-f][0-9a-f]*\).*/\1/p')"
  [ -n "$want" ] || return 1   # banner 無 hash 欄位 → 視為不自洽
  got="$(printf '%s' "$(sed '1d' "$target")" | sha256_hex | cut -c1-8)"
  [ "$want" = "$got" ]
}

# ── lint（六條；任一 hard-fail → 非零 exit）──
lint() {
  local fail=0

  # rule 1: routing 逐名點名清單 + host:*-only 豁免的 skill 名必須存在於 skills/
  #         （9 死名事故的結構性根絕——手寫 skill 清單腐爛的那一類）
  local known name line
  known="$(ls -1 skills)"
  line="$(grep '逐名點名' core/routing.md || true)"
  if [ -n "$line" ]; then
    # 取全形冒號後的名單，以 、 切分，濾出 kebab/單詞 token
    for name in $(printf '%s\n' "$line" | awk -F'：' '{print $NF}' \
                  | tr '、' '\n' | sed 's/[。[:space:]]//g' | grep -E '^[a-z0-9-]+$'); do
      if ! printf '%s\n' "$known" | grep -qx "$name"; then
        note "  [lint1 FAIL] routing 逐名點名 '$name' 不存在於 skills/"; fail=1
      fi
    done
  fi
  # rule 1b: core/hosts 反引號引用的 kebab token 必須是實存 skill 或列名豁免
  #          （9 死名教訓的另一半：host delta / 通用路由行手寫 skill 名一樣會腐爛）
  #          豁免 = 特意提及的非 skill 名（reviewer slug、已移除 plugin 名等）
  local NONSKILL='copilot-pull-request-reviewer spark copilot-sdk security-guidance chrome-devtools playwright microsoft-learn hookify claude-local-gitignore secret-scan'
  local tok f2
  for f2 in core/*.md hosts/*.md; do
    for tok in $(grep -o '`[a-z][a-z0-9-]*`' "$f2" | tr -d '\`' | sort -u); do
      printf '%s\n' "$known" | grep -qx "$tok" && continue
      printf '%s\n' $NONSKILL | grep -qx "$tok" && continue
      note "  [lint1b FAIL] $f2 反引號引用 '$tok' 非實存 skill 也不在豁免清單"; fail=1
    done
  done

  # rule 2: rules/*.md 必有 paths frontmatter
  if compgen -G 'rules/*.md' >/dev/null 2>&1; then
    local rf
    for rf in rules/*.md; do
      head -5 "$rf" | grep -q '^paths:' || { note "  [lint2 FAIL] $rf 缺 paths frontmatter"; fail=1; }
    done
  fi

  # rule 3: ~/.claude/rules/ 下禁非 symlink 散檔（防 host 端偷長分岔正本）
  #         僅在 rules/ 已成正本（Step 5 遷入）後強制——遷入前 ~/.claude/rules 的實體檔即正本。
  if compgen -G 'rules/*.md' >/dev/null 2>&1 && [ -d "$HOME/.claude/rules" ]; then
    local stray
    stray="$(find "$HOME/.claude/rules" -maxdepth 1 -type f 2>/dev/null || true)"
    [ -z "$stray" ] || { note "  [lint3 FAIL] ~/.claude/rules 有非 symlink 散檔：$stray"; fail=1; }
  fi

  # rule 4: 五要素義務——每條 [Tx-y]/[Rx] 規則行必含「觸發：」與「驗證：」（反例義務的機械代理）
  local rl
  for f in core/tier0-safety.md core/tier1-workflow.md core/tier2-style.md core/routing.md; do
    while IFS= read -r rl; do
      case "$rl" in
        \[[TR]*\]*|\[[TR][0-9]*) : ;;
      esac
      if printf '%s' "$rl" | grep -qE '^\[[TR][0-9]'; then
        printf '%s' "$rl" | grep -q '觸發：' && printf '%s' "$rl" | grep -q '驗證：' \
          || { note "  [lint4 FAIL] $f 規則行缺 觸發：/驗證：：${rl:0:40}…"; fail=1; }
      fi
    done < "$f"
  done

  # rule 5: 硬預算——tier0 ≤30 行、routing ≤30 行、每 host 組裝 ≤10KB
  local t0 rt
  t0="$(strip_meta core/tier0-safety.md | grep -c '' || true)"
  rt="$(strip_meta core/routing.md | grep -c '' || true)"
  [ "$(wc -l < core/tier0-safety.md)" -le "$TIER0_MAX" ] || { note "  [lint5 FAIL] tier0 > $TIER0_MAX 行"; fail=1; }
  [ "$(wc -l < core/routing.md)"      -le "$ROUTING_MAX" ] || { note "  [lint5 FAIL] routing > $ROUTING_MAX 行"; fail=1; }
  local row host out delta bytes
  printf '%s' "$TARGETS" | while IFS='|' read -r host out delta; do
    [ -n "$host" ] || continue
    bytes="$(render_target "$delta" | wc -c | tr -d ' ')"
    if [ "$bytes" -gt "$BUDGET" ]; then
      note "  [lint5 FAIL] $host 組裝 ${bytes}B > ${BUDGET}B"
      echo FAIL > "$AGENTS/.lint5.tmp"
    fi
  done
  [ -f "$AGENTS/.lint5.tmp" ] && { fail=1; rm -f "$AGENTS/.lint5.tmp"; }

  # rule 6: superpowers 版本一致性（三家 plugin 註冊版本；不一致僅警告，02 line 82）
  # best-effort：無統一註冊面時跳過（UNVERIFIED），不 hard-fail
  return "$fail"
}

# 印各 host 組裝位元組（供 --check 觀察預算）
report_sizes() {
  local host out delta bytes
  printf '%s' "$TARGETS" | while IFS='|' read -r host out delta; do
    [ -n "$host" ] || continue
    bytes="$(render_target "$delta" | wc -c | tr -d ' ')"
    printf '  %-16s %6sB / %sB  %s\n' "$host" "$bytes" "$BUDGET" \
      "$([ "$bytes" -le "$BUDGET" ] && echo ✅ || echo ❌超標)"
  done
}

write_manifest() {
  local host out delta full mf; mf="$AGENTS/dist/manifest.tsv"
  mkdir -p "$AGENTS/dist"
  # skill-index.md 產物 + 最小自檢：行數（去 marker）== skills 目錄數（02 line 66，防生成器 bug）
  emit_skill_index > "$AGENTS/dist/skill-index.md"
  local idx_n skills_n
  idx_n="$(grep -vc '^<!-- agents-skill-index' "$AGENTS/dist/skill-index.md")"
  skills_n="$(ls -1 skills | wc -l | tr -d ' ')"
  [ "$idx_n" = "$skills_n" ] || die "skill-index 自檢失敗：index ${idx_n} 行 ≠ skills ${skills_n} 個"
  : > "$mf"
  printf '%s' "$TARGETS" | while IFS='|' read -r host out delta; do
    [ -n "$host" ] || continue
    full="$(render_target "$delta")"
    printf '%s\t%s\t%s\n' "$host" "$out" "$(printf '%s\n' "$full" | sha256_hex)" >> "$mf"
    printf '%s\n' "$full" > "$AGENTS/dist/$(basename "$out")"
  done
}

deploy() {
  lint || die 'lint 未過，拒絕部署'
  local host out delta target new tmp bad=0
  # ── phase 1：唯讀 prescan。任一目標缺 banner 或 body 經手改即先攔、零寫入。
  #    原子性：避免「先覆寫幾家、撞到竄改檔中止」留下部分部署的裂解狀態。
  #    自洽而非比對 manifest：source 變更後「乾淨但過期」的生成檔仍自洽 → 正常覆寫，
  #    不誤判為竄改（spec 02 #2/#3：hash 不符才拒覆寫+輸出 diff = 唯一無資料損失路徑）。
  while IFS='|' read -r host out delta; do
    [ -n "$host" ] || continue
    [ -z "$ONLY" ] || case "$host" in *"$ONLY"*) ;; *) continue ;; esac
    target="$DEPLOY_ROOT/$out"
    [ -f "$target" ] || continue
    if ! grep -q '^<!-- GENERATED by ~/.agents/bin/agents-sync' "$target"; then
      note "no-clobber: $out 無 GENERATED banner（疑手寫檔）——拒覆寫，請先歸檔"; bad=1; continue
    fi
    if ! banner_body_hash_matches "$target"; then
      new="$(render_target "$delta")"; tmp="$(mktemp "${TMPDIR:-/tmp}/agents-sync.XXXXXX")"
      printf '%s\n' "$new" > "$tmp"
      note "no-clobber: $out banner 在但 body hash 與 banner 不符（疑手改/竄改）——拒覆寫。與正本 diff（< 現檔 / > 正本）："
      diff "$target" "$tmp" >&2 || true
      rm -f "$tmp"; bad=1
    fi
  done <<< "$TARGETS"
  [ "$bad" -eq 0 ] || die '偵測到手改/竄改部署檔，已全部中止（未寫入任何一家）——請歸檔或以正本覆蓋後重跑'
  # ── phase 2：原子寫入。渲染到同目錄暫存檔再 mv -f（同 FS 保證 rename 原子）；冪等則跳過。
  while IFS='|' read -r host out delta; do
    [ -n "$host" ] || continue
    [ -z "$ONLY" ] || case "$host" in *"$ONLY"*) ;; *) continue ;; esac
    target="$DEPLOY_ROOT/$out"
    new="$(render_target "$delta")"
    # 冪等比對用純 bash 字串等值（command-substitution 兩側同樣去尾換行，對 trailing newline 漂移免疫）
    if [ -f "$target" ] && [ "$new" = "$(cat "$target")" ]; then
      printf '  = %s（未變，跳過）\n' "$out"; continue
    fi
    mkdir -p "$(dirname "$target")"
    tmp="$(mktemp "$(dirname "$target")/.agents-sync.XXXXXX")"
    printf '%s\n' "$new" > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$target"
    printf '  + %s（已寫入）\n' "$out"
  done <<< "$TARGETS"
  refresh_claude_stamp
  write_manifest
}

# ~/.claude/CLAUDE.md 末尾 routing stamp（agents-routing:begin/end 區塊）機械刷新。
# 手動快照必 drift（實證 2026-07-08：routing.md 加行後 stamp 停在舊版）；CLAUDE.md 本體歸 dotclaude 手寫，僅此區塊由本工具管。
refresh_claude_stamp() {
  local cf="$DEPLOY_ROOT/.claude/CLAUDE.md" routing="$AGENTS/core/routing.md"
  [ -f "$cf" ] && [ -f "$routing" ] || return 0
  grep -q '<!-- agents-routing:begin' "$cf" || return 0
  local tmp; tmp="$(mktemp "$(dirname "$cf")/.agents-stamp.XXXXXX")"
  awk -v routing="$routing" -v today="$(date +%Y-%m-%d)" '
    /<!-- agents-routing:begin/ {
      print "<!-- agents-routing:begin | generated-from: ~/.agents/core/routing.md | last-verified: " today " -->"
      while ((getline line < routing) > 0) print line
      close(routing)
      skip=1; next
    }
    /<!-- agents-routing:end/ { print "<!-- agents-routing:end -->"; skip=0; next }
    !skip { print }
  ' "$cf" > "$tmp"
  if cmp -s "$tmp" "$cf"; then rm -f "$tmp"; printf '  = .claude/CLAUDE.md routing stamp（未變）\n'
  else chmod 0644 "$tmp" && mv -f "$tmp" "$cf"; printf '  + .claude/CLAUDE.md routing stamp（已刷新）\n'; fi
}

check() {
  note '── lint ──'
  if lint; then note '  lint: PASS'; else note '  lint: FAIL'; fi
  note '── 每 host 組裝位元組（dry-run，未部署）──'
  report_sizes
  note '── manifest hash（若部署將寫入）──'
  local host out delta
  printf '%s' "$TARGETS" | while IFS='|' read -r host out delta; do
    [ -n "$host" ] || continue
    printf '  %-16s %s\n' "$host" "$(render_target "$delta" | sha256_hex | cut -c1-8)"
  done
  lint  # exit code = lint 結果
}

bootstrap() {
  # 重建 ~/.claude 下相對 symlink（core / skills / rules；三者缺一即 CLAUDE.md @import 或路由靜默斷鏈）
  local s name
  mkdir -p "$HOME/.claude/core"
  for s in core/tier0-safety.md core/tier1-workflow.md core/tier2-style.md; do
    name="$(basename "$s")"
    ln -sfn "../../.agents/core/$name" "$HOME/.claude/core/$name"
  done
  mkdir -p "$HOME/.claude/skills"
  for s in skills/*/; do
    name="$(basename "$s")"
    ln -sfn "../../.agents/skills/$name" "$HOME/.claude/skills/$name"
  done
  if compgen -G 'rules/*.md' >/dev/null 2>&1; then
    mkdir -p "$HOME/.claude/rules"
    for s in rules/*.md; do
      name="$(basename "$s")"
      ln -sfn "../../.agents/rules/$name" "$HOME/.claude/rules/$name"
    done
  fi
  deploy
}

doctor() {
  local rc=0
  note '── 斷鏈掃描 ~/.claude/{core,rules,skills} ──'
  local broken d
  for d in core rules skills; do
    broken="$(find -L "$HOME/.claude/$d" -maxdepth 1 -type l 2>/dev/null | while read -r l; do [ -e "$l" ] || echo "$l"; done)"
    if [ -z "$broken" ]; then note "  $d 斷鏈: 0 ✅"; else note "  $d 斷鏈: FAIL ❌ $broken"; rc=1; fi
  done
  # core 三檔必須存在（CLAUDE.md @import 目標；缺=tier0 整層靜默消失）
  for s in tier0-safety.md tier1-workflow.md tier2-style.md; do
    [ -e "$HOME/.claude/core/$s" ] || { note "  core/$s 缺失 ❌（CLAUDE.md @import 斷鏈）"; rc=1; }
  done

  note '── override 不存在 ──'
  if [ -e "$HOME/.codex/AGENTS.override.md" ]; then note '  AGENTS.override.md 仍存在 ❌（3D 前為預期）'; rc=1; else note '  override 不存在 ✅'; fi

  note '── manifest 相符（部署檔 hash == manifest）──'
  if [ -f "$AGENTS/dist/manifest.tsv" ]; then
    local host out want got
    while IFS=$'\t' read -r host out want; do
      [ -f "$DEPLOY_ROOT/$out" ] || { note "  $out UNAVAILABLE（未部署）"; continue; }
      got="$(sha256_hex < "$DEPLOY_ROOT/$out")"
      [ "$got" = "$want" ] && note "  $out 相符 ✅" || { note "  $out DRIFT ❌"; rc=1; }
    done < "$AGENTS/dist/manifest.tsv"
  else
    note '  manifest.tsv 不存在 UNAVAILABLE（尚未部署）'
  fi

  note '── 三家 FP 探針指令（依 CLI 0.142.5 介面；升版後可能變動）──'
  note "  claude  -p '輸出 context 中所有 FP: 開頭 codeword'"
  note "  codex   debug prompt-input 'x' | grep -c 'FP:AGENTS-T0'"
  note "  copilot -p '複誦 context 內 FP: 開頭 codeword' --available-tools="
  note '── skill 可見度探針（skill 本體 vs 各 host 發現機制）──'
  note "  claude : ls -L ~/.claude/skills/dev-workflow/SKILL.md（symlink 解析）"
  note "  copilot: copilot -p '列出 available_skills 中含 dev-workflow 者' --available-tools=（已驗證原生載入 ~/.agents/skills）"
  note "  codex  : UNVERIFIED——無 skill 載入設定，取用靠 routing 點名後直讀檔；探針=問模型「dev-workflow SKILL.md 路徑」應答 ~/.agents/skills/..."
  return "$rc"
}

case "${1:-}" in
  --check)     check ;;
  --bootstrap) bootstrap ;;
  --doctor)    doctor ;;
  --only)      ONLY="${2:?用法：--only <host 子字串>，如 copilot / codex}"; deploy ;;
  ''|--deploy) deploy ;;
  *) die "未知參數：$1（用 --check / --bootstrap / --doctor / --only <host> / 無參數=部署）" ;;
esac
