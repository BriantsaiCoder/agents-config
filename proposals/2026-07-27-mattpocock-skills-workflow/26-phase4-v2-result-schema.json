{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "completed": {
      "type": "boolean"
    },
    "route_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "selected_workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "enum": [
                  "selected",
                  "supporting"
                ]
              },
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "enum": [
                  "skill-tool",
                  "skill-file",
                  "injected-policy"
                ]
              }
            },
            "required": [
