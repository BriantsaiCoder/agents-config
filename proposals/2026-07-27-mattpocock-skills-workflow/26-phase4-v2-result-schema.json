              "role",
              "workflow",
              "source"
            ]
          }
        }
      },
      "required": [
        "version",
        "selected_workflows",
        "supporting_workflows",
        "events"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "completed",
    "route_telemetry",
    "evidence",
    "summary"
  ]
